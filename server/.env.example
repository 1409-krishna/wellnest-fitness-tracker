# ==============================================================================
# WELLNEST BACKEND CONFIGURATION (.env)
# ==============================================================================
# Port & Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Authentication
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fitness_wellness_tracker?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_min_32_characters_random_string

# Google Authentication (OAuth 2.0 Web Client)
# Used for Google One-Tap & Sign-In validation
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS (Safe fallbacks implemented if left unconfigured)
# ------------------------------------------------------------------------------

# Feature 2: Google Gemini AI (Wellness Planner & AI Coach)
# Get key: https://aistudio.google.com/app/apikey
# Fallback: Intelligent algorithmic planner if key is omitted
GEMINI_API_KEY=your_gemini_api_key_here

# Feature 4: Cloudinary (Avatar & Activity Cover Image Uploads)
# Get credentials: https://cloudinary.com/console
# Fallback: Base64 data-URI storage in MongoDB if omitted
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Feature 5: Google Calendar API (Workout & Habit Sync)
# Get credentials from Google Cloud Console (Calendar API enabled)
# Fallback: Generates direct web intent URLs and RFC-5545 .ics calendar files
GOOGLE_CALENDAR_CLIENT_ID=your_google_calendar_client_id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_calendar_client_secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/calendar/callback

# Feature 6: Nodemailer (Email Notifications & Weekly Reports)
# For Gmail, generate an App Password: https://myaccount.google.com/apppasswords
# Fallback: Formatted logs printed to backend terminal in development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=Wellnest Wellness <your_email@gmail.com>
